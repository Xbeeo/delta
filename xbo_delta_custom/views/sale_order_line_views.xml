<odoo>
    <record id="sale_order_form_inherit_custom_qty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="custom_qty" optional="hide"/>
                <field name="custom_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>