<odoo>
    <data>
        <record id="od_roduct_product_normal_form_view_inherit" model="ir.ui.view">
            <field name="name">product.product.normal.form.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='list_price']/ancestor::group[1]" position="after">
                    <group name="uom_conversion" string="UOM Conversion">
                        <field name="conversion_value"/>
                        <field name="conversion_uom_id"/>
                        <field name="converted_value"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>